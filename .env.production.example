# 应用与数据库：这里只放网站运行账号，禁止放迁移账号。
DATABASE_URL=postgresql://data_statistics_runtime:RUNTIME_PASSWORD@HOST:5432/data_statistics?schema=public
APP_INTERNAL_URL=http://127.0.0.1:3000
# 浏览器跳转只使用这个正式地址，不相信客户端提交的 Host 请求头。
APP_PUBLIC_ORIGIN=https://YOUR-PUBLIC-DOMAIN.example
# 一线端和管理端使用同一主域名的不同子域时填写，例如 .example.com；同域部署可留空。
SESSION_COOKIE_DOMAIN=.YOUR-PUBLIC-DOMAIN.example
DAILY_JOB_SECRET=请换成至少32位随机字符串

# DeepSeek：Key 只放服务器，不要写进代码或发到聊天
DEEPSEEK_API_KEY=sk-请填写你的DeepSeekKey
DEEPSEEK_MODEL=deepseek-v4-flash

# 电报：唯一接收人是老板群
TELEGRAM_BOT_TOKEN=请填写BotFather生成的Token
TELEGRAM_BOSS_CHAT_ID=请填写老板群ChatID

# 数据库备份加密密码，务必与登录密码不同并离线保存
BACKUP_ENCRYPTION_PASSWORD=请换成高强度独立密码
