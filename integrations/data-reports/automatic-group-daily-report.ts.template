export function isGroupDailyCheckDue(group: GroupDailySchedule, now = new Date()) {
  const local = localClockMinutes(now, group.timezone);
  const sinceEnd = (local - group.workEndMinutes + 1440) % 1440;
  return sinceEnd >= GROUP_DAILY_DELAY_MINUTES
    && sinceEnd < GROUP_DAILY_DELAY_MINUTES + GROUP_DAILY_DUE_WINDOW_MINUTES;
}

const percent = (numerator: number, denominator: number) => denominator > 0 ? numerator / denominator * 100 : null;
const pct = (value: number | null) => value === null ? "—" : `${value.toFixed(1)}%`;
const cash = (value = 0) => `$${(value / 100).toLocaleString("en-US", { maximumFractionDigits: 2 })}`;
const nonzero = (row: StaffRow) => Object.values(row.values).some((value) => value !== 0);
const value = (row: StaffRow | undefined, key: string) => row?.values[key] ?? 0;

function receptionRates(t: ReportTotals) {
  return { reply: percent(t.replied, t.effective), join: percent(t.joined, t.effective) };
}

function peopleById(...lists: Array<StaffRow[] | undefined>) {
  const result = new Map<string, StaffRow>();
  for (const list of lists) for (const row of list ?? []) if (nonzero(row)) result.set(row.id, row);
  return result;
}

function receptionLines(title: string, dailyRows: StaffRow[] | undefined, monthlyRows: StaffRow[] | undefined) {
  const daily = peopleById(dailyRows);
  const monthly = peopleById(monthlyRows);
  const ids = new Set([...daily.keys(), ...monthly.keys()]);
  if (!ids.size) return [title, "— 今日和本月暂无发生量", ""];
  return [title, ...[...ids].map((id) => {
    const day = daily.get(id), month = monthly.get(id);
    const name = day?.name ?? month?.name ?? "历史负责人";
    return `${name}｜今日：有效 ${value(day, "effective")}｜回复 ${value(day, "replied")}｜进群 ${value(day, "joined")}｜开单 ${value(day, "ordered")}｜首充 ${cash(value(day, "initialDepositCents"))}｜续充 ${cash(value(day, "rechargeCents"))}｜净 ${cash(value(day, "netCents"))}\n本月：有效 ${value(month, "effective")}｜回复 ${value(month, "replied")}｜进群 ${value(month, "joined")}｜开单 ${value(month, "ordered")}｜首充 ${cash(value(month, "initialDepositCents"))}｜续充 ${cash(value(month, "rechargeCents"))}｜净 ${cash(value(month, "netCents"))}`;
  }), ""];
}

