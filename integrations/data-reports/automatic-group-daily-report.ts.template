export function formatAutomaticGroupDailyReport(report: BossReport, readiness: GroupDailyReadiness, alerts: DailyAlert[] = []) {
  if(report.groupType==='HACKER'&&report.insights)return compactGroupText(report);
  const country = businessTimezoneOption(report.timezone ?? "Asia/Shanghai").countryLabel;
  const dailyRates = receptionRates(report.daily);
  const monthRates = receptionRates(report.monthly);
  const third = readiness.thirdDay;
  const d3Completed = third.earlyToday + third.onTimeToday;

  if (report.groupType === "LAWYER") return [
    `📊 ${country}｜${report.departmentName ?? "未分部门"}｜${report.groupName}`,
    `${report.date} 收工日报`, "",
    "【小组汇总】",
    `今日：添加 ${report.daily.added}｜回复 ${report.daily.replied}｜真实案件 ${report.daily.lawyerRealCase}｜注册 ${report.daily.registered}｜开单 ${report.daily.ordered}`,
    `今日业绩：首充 ${cash(report.daily.initialDepositCents)}｜续充 ${cash(report.daily.rechargeCents)}｜出金 ${cash(report.daily.withdrawalCents)}｜净业绩 ${cash(report.daily.netCents)}`,
    `本月：添加 ${report.monthly.added}｜回复 ${report.monthly.replied}｜真实案件 ${report.monthly.lawyerRealCase}｜注册 ${report.monthly.registered}｜开单 ${report.monthly.ordered}`,
    `本月业绩：首充 ${cash(report.monthly.initialDepositCents)}｜续充 ${cash(report.monthly.rechargeCents)}｜出金 ${cash(report.monthly.withdrawalCents)}｜净业绩 ${cash(report.monthly.netCents)}`,
    "",
    ...receptionLines("【个人汇总】", report.dailyReception, report.reception),
    ...formatDailyAlerts(alerts),
  ].join("\n");

  return [
    `📊 ${country}｜${report.departmentName ?? "未分部门"}｜${report.groupName}`,
    `${report.date} 收工日报`, "",
    "【小组汇总】",
    "接粉",
    `今日：添加 ${report.daily.added}｜有效 ${report.daily.effective}｜回复 ${report.daily.replied}（${pct(dailyRates.reply)}）｜进群 ${report.daily.joined}（${pct(dailyRates.join)}）｜推专家 ${report.daily.pushed}`,
    `本月：添加 ${report.monthly.added}｜有效 ${report.monthly.effective}｜回复 ${report.monthly.replied}（${pct(monthRates.reply)}）｜进群 ${report.monthly.joined}（${pct(monthRates.join)}）｜推专家 ${report.monthly.pushed}`,
    "",
    "炒群",
    `今日：承接进群 ${report.daily.joined}｜正常退群 ${report.daily.leftNormal}｜异常退群 ${report.daily.leftAbnormal}｜推专家 ${report.daily.pushed}`,
    `本月：承接进群 ${report.monthly.joined}｜当前在群 ${report.monthly.inGroup}｜正常退群 ${report.monthly.leftNormal}｜异常退群 ${report.monthly.leftAbnormal}｜推专家 ${report.monthly.pushed}`,
    "",
    "专家",
    `今日：接手 ${report.daily.pushed}｜注册 ${report.daily.registered}｜开单 ${report.daily.ordered}`,
    `今日业绩：首充 ${cash(report.daily.initialDepositCents)}｜续充 ${cash(report.daily.rechargeCents)}｜出金 ${cash(report.daily.withdrawalCents)}｜净业绩 ${cash(report.daily.netCents)}`,
    `本月：接手 ${report.monthly.pushed}｜注册 ${report.monthly.registered}｜开单 ${report.monthly.ordered}`,
    `本月业绩：首充 ${cash(report.monthly.initialDepositCents)}｜续充 ${cash(report.monthly.rechargeCents)}｜出金 ${cash(report.monthly.withdrawalCents)}｜净业绩 ${cash(report.monthly.netCents)}`,
    "",
    "【第3天介绍专家】",
    `今日应推 ${third.dueToday}｜按时完成 ${d3Completed}｜迟推 ${third.lateToday}｜未推 ${third.overdueToday}`,
    third.overdueToday || third.overdueTotal ? "备注：第3天未推的客户允许继续跟进，已列入待跟进。" : "",
    "",
    ...receptionLines("【个人汇总｜接粉】", report.dailyReception, report.reception),
    ...operatorLines("【个人汇总｜炒群】", report.dailyOperators, report.operators),
    ...expertLines("【个人汇总｜专家】", report.dailyExperts, report.experts),
    ...formatDailyAlerts(alerts),
  ].filter(Boolean).join("\n");
}

export async function loadReadyAutomaticGroupReports(now = new Date()) {
  // 日报随启用小组自动生效，不再靠环境变量维护一份容易漏掉的新组名单。
  // 没有在职成员的小组无需发送；名称含“测试”的系统测试组不进入正式群推送。
  const groups = await db.teamGroup.findMany({
    where: {
      active: true,
      name: { not: { contains: "测试" } },
      department: { active: true },
      members: { some: { active: true } },
    },
    include: { department: true },
    orderBy: [{ department: { name: "asc" } }, { name: "asc" }],
  });
  const results: Array<{ groupId: string; groupName: string; date: string; ready: boolean; missing: string[]; text?: string; richHtml?: string; dependencies?: string[] }> = [];
  const countryReports = new Map<string, BossReport[]>();
  for (const group of groups) {
    const businessTime = resolveGroupBusinessTime(group);
    const schedule = { id: group.id, name: group.name, ...businessTime };
    if (!isGroupDailyCheckDue(schedule, now)) continue;
    const date = groupDailyReportDate(schedule, now);
    let readiness: GroupDailyReadiness;
    let hackerRows: Array<{ groupId: string; data: string; updatedAt: Date }> = [];
    if (group.groupType === "HACKER") {
      hackerRows = await db.customerSheetRow.findMany({
        where: sheetStatisticsGroupWhere(group.id),
        select: { groupId: true, data: true, updatedAt: true },
      });
      readiness = inspectGroupDailyReadiness(hackerRows, group.id, date, now);
    } else {
      const [reporters, entries] = await Promise.all([
        db.user.findMany({
          where: {
            groupId: group.id,
            active: true,
            OR: [
              { role: { in: ["RECEPTION", "GROUP_OPERATOR", "EXPERT", "LEAD"] } },
              { roleAssignments: { some: { role: { in: ["RECEPTION", "GROUP_OPERATOR", "EXPERT", "LEAD"] } } } },
            ],
          },
          select: { id: true, name: true },
        }),
        db.dailyStatEntry.findMany({
          where: { groupId: group.id, businessDate: date, approvedRevisionId: { not: null } },
          select: { ownerId: true, updatedAt: true },
        }),
      ]);
      readiness = inspectManualGroupDailyReadiness(reporters, entries, now);
    }
    const report = await buildBossReport(group.id, date, now);
    const alerts = group.groupType === "HACKER" ? inspectGroupDailyAlerts({ report, rows: hackerRows }) : [];
    results.push({
      groupId: group.id, groupName: group.name, date, ready: true, missing: readiness.missing,
      text: formatAutomaticGroupDailyReport(report, readiness, alerts),
      richHtml: report.groupType==='HACKER'?reportHtml(compactGroupText(report)):formatAutomaticGroupDailyRichReport(report, readiness, alerts),
    });
    if(report.groupType==='HACKER') {const k=(report.countryCode||report.departmentName||'unknown')+':'+date;countryReports.set(k,[...(countryReports.get(k)||[]),report]);}
  }
  for(const [key,reports] of countryReports){
    const text=countryAnalysisText(reports);
    results.push({groupId:'country:'+key,groupName:'国家能力分析',date:reports[0].date,ready:true,missing:[],text,richHtml:reportHtml(text),dependencies:reports.map(r=>r.groupId+':'+r.date)});
  }
  return results;
}
