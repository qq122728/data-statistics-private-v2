[Unit]
Description=Resource Adviser native Hermes Telegram gateway
After=network-online.target data-statistics-resource-bot.service
Wants=network-online.target
Requires=data-statistics-resource-bot.service
[Service]
Type=simple
User=hermes-resource
Group=hermes-resource
WorkingDirectory=/var/lib/hermes-resource
Environment=HERMES_HOME=/var/lib/hermes-resource/.hermes
Environment=HOME=/var/lib/hermes-resource
Environment=PYTHONPATH=/opt/hermes-boss-agent
Environment=HERMES_SUPERVISED_CHILD=1
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/data-statistics/hermes-resource.env
EnvironmentFile=/etc/data-statistics/resource-native-telegram.env
UnsetEnvironment=INVOCATION_ID
ExecStart=/opt/hermes-boss-agent/.venv/bin/hermes gateway run
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hermes-resource
ReadOnlyPaths=/var/lib/hermes-resource/.hermes/config.yaml /var/lib/hermes-resource/.hermes/SOUL.md /var/lib/hermes-resource/.hermes/INSTRUCTIONS.md /var/lib/hermes-resource/.hermes/plugins /var/lib/resource-reports
InaccessiblePaths=/etc/data-statistics /opt/data-statistics-v2 /opt/data-statistics-resource-bot /var/lib/hermes-boss
MemoryMax=1G
TimeoutStopSec=150
StandardOutput=null
StandardError=journal
[Install]
WantedBy=multi-user.target
