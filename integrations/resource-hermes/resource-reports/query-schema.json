{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "view": {
      "default": "effects",
      "type": "string",
      "enum": [
        "effects",
        "orders",
        "phone",
        "issues",
        "analysis",
        "help"
      ]
    },
    "dimension": {
      "default": "buyer",
      "type": "string",
      "enum": [
        "buyer",
        "channel",
        "country",
        "material"
      ]
    },
    "type": {
      "default": "ALL",
      "type": "string",
      "enum": [
        "ALL",
        "ADS",
        "SMS"
      ]
    },
    "period": {
      "default": "month",
      "type": "string",
      "enum": [
        "today",
        "yesterday",
        "month",
        "lastMonth",
        "custom",
        "all"
      ]
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "channel": {
      "default": "",
      "type": "string",
      "maxLength": 100
    },
    "buyer": {
      "default": "",
      "type": "string",
      "maxLength": 100
    },
    "country": {
      "default": "",
      "type": "string",
      "maxLength": 10
    },
    "material": {
      "default": "",
      "type": "string",
      "maxLength": 100
    },
    "phone": {
      "default": "",
      "type": "string",
      "maxLength": 24
    },
    "sort": {
      "default": "opened",
      "type": "string",
      "enum": [
        "opened",
        "rate",
        "cost",
        "imported",
        "net"
      ]
    },
    "page": {
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "excel": {
      "default": false,
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
