# Install as /etc/data-statistics/dr-alert.env with mode 0600.
# Use a dedicated monitoring endpoint; never put a database or storage secret here.
DR_ALERT_WEBHOOK_URL=https://monitoring.example.invalid/hooks/replace-me
# The external deadman must alert if this five-minute heartbeat stops arriving.
DR_DEADMAN_WEBHOOK_URL=https://monitoring.example.invalid/deadman/replace-me
