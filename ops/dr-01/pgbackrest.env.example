# Copy to a root-only secret source outside the repository. Do not commit real values.
# The renderer rejects blank values and writes the generated pgBackRest config mode 0640.
PGBACKREST_PG1_PATH=/var/lib/postgresql/16/main
PGBACKREST_REPO1_PATH=/data-statistics/production
PGBACKREST_S3_BUCKET=replace-with-dedicated-backup-bucket
PGBACKREST_S3_ENDPOINT=s3.example.invalid
PGBACKREST_S3_REGION=replace-with-region
PGBACKREST_S3_URI_STYLE=path
PGBACKREST_S3_KEY=replace-with-dedicated-prefix-access-key
PGBACKREST_S3_KEY_SECRET=replace-with-secret-key
PGBACKREST_REPO1_CIPHER_PASS=replace-with-long-random-passphrase-from-secret-manager
