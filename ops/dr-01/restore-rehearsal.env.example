# Install as root-owned /etc/data-statistics/dr-restore.env mode 0600 only
# after a DBA approves the release manifest and restricted production counts.
DR_APPROVAL_ENV_FILE=/etc/data-statistics/dr-restore.env
DR_REPO_MIGRATION_MANIFEST=/usr/local/share/data-statistics-dr/migration-manifest.sha256
# The systemd unit injects read-only credential copies of the separate
# root:root 0600 production ledger and baseline-checksum approval files.
DR_MIGRATION_LEDGER_APPROVAL_ID=replace-with-dba-ledger-change-or-evidence-id
DR_EXPECTED_MIGRATION_COUNT=24
DR_EXPECTED_LATEST_MIGRATION=20260826233000_add_department_manager_scope
DR_BASELINE_APPROVAL_ID=replace-with-change-ticket-or-restricted-evidence-id
DR_MIN_USERS=replace-with-approved-positive-count
DR_MIN_GROUPS=replace-with-approved-positive-count
DR_MIN_LEADS=replace-with-approved-positive-count
DR_MIN_ORDERS=replace-with-approved-positive-count
