[Unit]
Description=Verify Data Statistics backup, upload, and WAL archive health
After=postgresql.service network-online.target
Wants=network-online.target
OnFailure=data-statistics-dr-alert@%n.service

[Service]
Type=oneshot
User=postgres
Group=postgres
Environment=PGBACKREST_STANZA=data-statistics
Environment=PGBACKREST_MAX_ANY_AGE_SECONDS=129600
Environment=PGBACKREST_MAX_FULL_AGE_SECONDS=691200
Environment=PGBACKREST_MAX_ARCHIVE_AGE_SECONDS=600
Environment=DR_HEALTH_VALIDATOR=/usr/local/lib/data-statistics-dr/validate-backup-health.py
EnvironmentFile=/etc/data-statistics/dr-alert.env
ExecStart=/usr/local/lib/data-statistics-dr/pgbackrest-healthcheck.sh
TimeoutStartSec=10m
PrivateTmp=true
NoNewPrivileges=true
UMask=0027
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/log/pgbackrest /var/spool/pgbackrest /var/lock/pgbackrest
