[Unit]
Description=Send encrypted Data Statistics database backup
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=oneshot
User=data-statistics
Group=data-statistics
WorkingDirectory=/opt/data-statistics-v2/current/backend
EnvironmentFile=/etc/data-statistics/app.env
ExecStart=/usr/local/bin/npm run backup:daily
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
