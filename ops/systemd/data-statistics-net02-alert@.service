[Unit]
Description=Send NET-02 failure alert for %i
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/data-statistics/net02-monitor.env
ExecStart=/usr/local/lib/data-statistics/send-data-statistics-net02-alert "systemd unit failed" %i
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
