[Unit]
Description=Expire temporary NET-02 direct-origin web access
After=ufw.service
OnFailure=data-statistics-net02-alert@%n.service

[Service]
Type=oneshot
StateDirectory=data-statistics/net-02
StateDirectoryMode=0750
ExecStart=/usr/local/sbin/manage-data-statistics-emergency-web-access --expire
User=root
Group=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/etc/ufw /run /var/lib/data-statistics/net-02
TimeoutStartSec=1min
