[Unit]
Description=Data Statistics V2 Backend
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=data-statistics
Group=data-statistics
WorkingDirectory=/opt/data-statistics-v2/current/backend
EnvironmentFile=/etc/data-statistics/app.env
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/local/bin/npm run start -- -H 127.0.0.1 -p 3003
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/data-statistics-v2
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
