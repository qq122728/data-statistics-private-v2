# Install as /etc/data-statistics/net02-monitor.env, root:root mode 0600.
# Use dedicated HTTPS endpoints that contain no reusable credentials elsewhere.
NET02_ALERT_WEBHOOK_URL=https://monitoring.example.invalid/net02-alert
NET02_DEADMAN_WEBHOOK_URL=https://monitoring.example.invalid/net02-heartbeat
NET02_MAX_AGE_SECONDS=129600
