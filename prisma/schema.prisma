generator client {
  provider = "prisma-client-js"
}

// SQLite → PostgreSQL 搬运只使用权威根 schema 生成的独立客户端。
// 不再依赖 prisma/sqlite/schema.prisma（该文件是过时分叉）。
generator sqliteMigrationClient {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/sqlite-migration-client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RESOURCE_MANAGER
  COMPANY_MANAGER
  FINANCE
  HR
  LEAD
  RECEPTION
  GROUP_OPERATOR
  EXPERT
}

enum GroupType {
  HACKER
  LAWYER
}

// 总公司层，暂不单独建表：总公司管理员就是"没有 company 限定"的超级权限（需求文档1.1）。
model Company {
  id          String       @id @default(cuid())
  name        String       @unique
  active      Boolean      @default(true)
  departments Department[]
  // 阶段5a新增：Duty.COMPANY_MANAGER 账号的管辖范围（User.companyId 的反向关系）。
  managers    User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Department {
  id               String                  @id
  name             String                  @unique
  active           Boolean                 @default(true)
  companyId        String?
  company          Company?                @relation(fields: [companyId], references: [id])
  countryCode      String                  @default("CN")
  timezone         String                  @default("Asia/Shanghai")
  workStartMinutes Int                     @default(600)
  workEndMinutes   Int                     @default(1320)
  groups           TeamGroup[]
  managers         User[]
  managerScopes    UserManagedDepartment[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([companyId])
}

enum MetricKind {
  NEW_FANS
  EFFECTIVE_FANS
  NO_NUMBER
  DUPLICATE_FANS
  REPLIES
  GROUP_JOIN
  GROUP_LEAVE
  ABNORMAL_GROUP_LEAVE
  EXPERT_INTRO
  REGISTRATION
  ORDER
  RECHARGE
  WITHDRAWAL
  CHANNEL_PERFORMANCE
}

enum DepositMethod {
  CRYPTO
  BANK
}

enum LeadReplyStatus {
  NOT_REPLIED
  REPLIED
  FOLLOW_UP
}

enum LeadGroupStatus {
  NOT_JOINED
  JOINED
  LEFT
}

enum ReceptionCategory {
  PENDING
  VALID
  INVALID
  LOW_AMOUNT
  NO_WS
}

enum ReceptionChatStatus {
  NORMAL_CHAT
  READY_TO_JOIN
}

// 仅用于旧版本回滚兼容；新版业务不得读取或展示渠道定价。
enum FanCostMode {
  FREE
  PAID
}

// 渠道业务类型。FREE 仅保留给历史数据兼容，新建渠道不再使用“免费粉”。
enum ChannelType {
  SMS
  ADS
  REBATE
}

enum DeviceAccountType {
  NORMAL_WS
  BUSINESS_WS
  RCS
  SIG
}

enum LeadActivityKind {
  DEVICE_ASSIGNED
  REPLIED
  REPLY_UNDONE
  FOLLOWED_UP
  JOINED_GROUP
  LEFT_GROUP
  EXPERT_INTRODUCED
  EXPERT_CONTACTED
  REGISTERED
  MARKED_INVALID
  RESTORED_VALID
  GROUP_JOIN_REVOKED
  GROUP_LEAVE_REVOKED
  EXPERT_INTRO_REVOKED
  EXPERT_CONTACT_REVOKED
  REGISTRATION_REVOKED
  ORDER_VOIDED
  FINANCE_VOIDED
  PLAN_UPDATED
  GROUP_PROGRESS_UPDATED
  RECEPTION_STATUS_UPDATED
  RECEPTION_ARCHIVED
}

enum LeadExceptionKind {
  INVALID_FORMAT
  DUPLICATE_IN_PASTE
  COLLISION
  MANUAL_INVALID
}

enum InvalidFanReportStatus {
  PENDING
  APPROVED
  RETURNED
}

enum InvalidFanReportAction {
  REPORTED
  UPDATED
  APPROVED
  RETURNED
  CORRECTED
  SUPPLEMENTED
}

enum EmployeeStageOverride {
  TRAINING
  OBSERVATION
  FORMAL
  PAUSED
}

enum RecruitmentSource {
  DIRECT
  AGENT
}

enum RiskDecisionLevel {
  LIMIT_WATCH
  ELIMINATION_WATCH
}

enum AttendanceClockStatus {
  NORMAL
  LATE
  EARLY
}

enum AttendanceLeaveType {
  PERSONAL
  SICK
  OTHER
}

// 仅为线上旧结构和旧版本回滚保留；新版不提供考勤功能。
enum AttendanceLeaveDuration {
  FULL_DAY
  HALF_DAY
}

// 仅为线上旧结构和旧版本回滚保留；新版不提供历史考勤功能。
enum AttendanceHistoricalMark {
  PRESENT
  LEAVE
  HALF_DAY_LEAVE
}

enum NotificationType {
  GENERAL
  IMPORTANT
  REWARD
  REMINDER
}

enum NotificationTargetType {
  ALL
  GROUP
  ROLE
  USERS
}

enum ExpertWorkflowStage {
  QUEUED
  MATERIALS
  TRACKING
  PENDING_REGISTRATION
  PENDING_ORDER
  DECLINED_DEPOSIT
  ORDERED
  STALLED
}

// 岗位：干哪道工序。接粉/炒群可互相兼任，专家跟接粉/炒群互斥（需求文档1.4）。
enum Position {
  RECEPTION
  GROUP_OPERATOR
  EXPERT
}

// 职务：管不管人的"帽子"，0或1个，可以跟任意岗位叠加（组长+专家场景）。
enum Duty {
  LEAD
  DEPARTMENT_MANAGER
  COMPANY_MANAGER
  HQ_MANAGER
  RESOURCE_MANAGER
  FINANCE
}

// 历史客户补录审核状态，模式抄自 InvalidFanReportStatus（需求文档7.3）。
enum HistoricalReviewStatus {
  PENDING
  APPROVED
  RETURNED
}

// 每日统计账的流转状态。客户进度永远不能直接写入这套状态或数字。
enum DailyStatStatus {
  DRAFT
  PENDING
  RESOURCE_PENDING
  RETURNED
  APPROVED
  CORRECTION_PENDING
}

model User {
  id                          String                          @id
  employeeCode                String?                         @unique
  username                    String                          @unique @default("")
  name                        String
  passwordHash                String                          @default("")
  mustChangePassword          Boolean                         @default(false)
  role                        Role
  // 职务"帽子"，跟 role/UserPosition 的岗位维度独立叠加，不参与业绩归属（需求文档1.4）。
  duty                        Duty?
  active                      Boolean                         @default(true)
  groupId                     String?
  group                       TeamGroup?                      @relation(fields: [groupId], references: [id])
  departmentId                String?
  department                  Department?                     @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  managedDepartments          UserManagedDepartment[]
  // 阶段5a新增：仅供 Duty.COMPANY_MANAGER 账号使用，限定其管辖的公司（新架构 Company 层，
  // 与老 Role.COMPANY_MANAGER 用的 departmentId 是两条独立的权限线，互不影响）。
  // null 视为未设置=无权限，不是"全部"，避免忘填导致越权。Duty.HQ_MANAGER 不需要范围字段，
  // 见 Company 模型注释：总公司本身无限定即超级权限。
  companyId                   String?
  company                     Company?                        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  managementScopeName         String?
  managementCountryCode       String?
  events                      MetricEvent[]
  customerFinanceEvents       CustomerFinanceEvent[]          @relation("CustomerFinanceEnteredBy")
  customerOrders              CustomerOrder[]
  voidedMetricEvents          MetricEvent[]                   @relation("MetricEventVoidedBy")
  voidedCustomerFinanceEvents CustomerFinanceEvent[]          @relation("CustomerFinanceVoidedBy")
  voidedCustomerOrders        CustomerOrder[]                 @relation("OrderVoidedBy")
  leads                       LeadCustomer[]
  attributedLeads             LeadCustomer[]                  @relation("FanAttributionOwner")
  expertLeads                 LeadCustomer[]                  @relation("ExpertOwner")
  groupOperatorLeads          LeadCustomer[]                  @relation("GroupOperatorOwner")
  groupOperatorAssignments    GroupOperatorReception[]        @relation("GroupOperatorAssignments")
  receptionistAssignments     GroupOperatorReception[]        @relation("ReceptionistAssignments")
  groupOperatorPairingHistory GroupOperatorReceptionHistory[] @relation("GroupOperatorPairingHistory")
  receptionistPairingHistory  GroupOperatorReceptionHistory[] @relation("ReceptionistPairingHistory")
  createdPairingHistory       GroupOperatorReceptionHistory[] @relation("PairingHistoryCreatedBy")
  assignedDevices             Device[]                        @relation("DeviceAssignedMember")
  deviceAccounts              DeviceAccount[]
  leadActivities              LeadActivity[]
  exceptionActions            LeadException[]                 @relation("ExceptionActor")
  exceptionOwnership          LeadException[]                 @relation("ExceptionOwner")
  invalidFanReports           InvalidFanReport[]              @relation("InvalidFanReportReporter")
  reviewedInvalidFanReports   InvalidFanReport[]              @relation("InvalidFanReportReviewer")
  invalidFanReportAudits      InvalidFanReportAudit[]         @relation("InvalidFanReportAuditActor")
  roleAssignments             UserRoleAssignment[]
  membershipHistory           UserGroupMembership[]
  positionHistory             UserPosition[]                  @relation("UserPositionAssignee")
  createdUserPositions        UserPosition[]                  @relation("UserPositionCreatedBy")
  historicalReviewedLeads     LeadCustomer[]                  @relation("HistoricalReviewedBy")
  resourceChannelAccess       ResourceChannelAccess[]
  sessions                    Session[]
  confirmations               DailyEntryConfirmation[]
  attendanceRecords           AttendanceRecord[]
  sentNotifications           Notification[]                  @relation("NotificationSender")
  notificationRecipients      NotificationRecipient[]
  createdChannels             Channel[]                       @relation("ChannelCreatedBy")
  sentChannelReviews          ChannelReviewEntry[]            @relation("ChannelReviewSentBy")
  reviewedChannelReviews      ChannelReviewEntry[]            @relation("ChannelReviewReviewedBy")
  dailyStatEntries            DailyStatEntry[]                @relation("DailyStatOwner")
  reviewedDailyStats          DailyStatEntry[]                @relation("DailyStatReviewer")
  receptionSourceDailyStats   DailyStatEntry[]                @relation("DailyStatReceptionSource")
  operatorSourceDailyStats    DailyStatEntry[]                @relation("DailyStatOperatorSource")
  createdDailyStatRevisions   DailyStatRevision[]             @relation("DailyStatRevisionCreator")
  auditLogs                   AuditLog[]
  riskDecisions               RiskDecision[]                  @relation("RiskDecisionMember")
  madeRiskDecisions           RiskDecision[]                  @relation("RiskDecisionActor")
  hireDate                    String?
  recruitmentSource           RecruitmentSource?
  referrerName                String?
  stageOverride               EmployeeStageOverride?
  stageOverrideReason         String?
  stageOverrideAt             DateTime?
  lastLoginAt                 DateTime?
  createdAt                   DateTime                        @default(now())
  updatedAt                   DateTime                        @updatedAt

  @@index([departmentId])
  @@index([departmentId, managementCountryCode])
  @@index([companyId])
}

// 部门管理员可以同时负责多个部门；departmentId 继续保留为旧账号的主部门兼容字段。
model UserManagedDepartment {
  userId       String
  departmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  @@id([userId, departmentId])
  @@index([departmentId])
}

// 主岗位仍保存在 User.role，保证旧报表和历史事件口径不变。
// 这张表只记录账号额外可使用的一线工作台岗位。
model UserRoleAssignment {
  id        String   @id @default(cuid())
  userId    String
  role      Role
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([role])
}

// 人员代号识别同一个人；本表保留每次调组或调岗的有效区间。
// User.groupId / User.role 仍表示当前权限，历史报表不得用当前值覆盖过去归属。
model UserGroupMembership {
  id             String    @id @default(cuid())
  userId         String
  groupId        String
  role           Role
  secondaryRoles String?
  effectiveFrom  String
  effectiveTo    String?
  reason         String?
  createdById    String?
  createdAt      DateTime  @default(now())
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group          TeamGroup @relation(fields: [groupId], references: [id])

  @@unique([userId, effectiveFrom])
  @@index([groupId, effectiveFrom, effectiveTo])
  @@index([userId, effectiveTo])
}

// 强制的岗位历史表，取代 UserGroupMembership 的选填/手动模式（需求文档1.5/1.6）。
// 只能通过 transferUserPosition 服务函数写入：原子地关闭旧行的 effectiveTo、开一条新的。
// 按人统计业绩要用这张表查"当时的岗位"，不能读 User.groupId/role 这种活字段。
model UserPosition {
  id                 String    @id @default(cuid())
  userId             String
  position           Position
  // 兼任岗位（目前只有接粉⇄炒群互兼），格式和 UserGroupMembership.secondaryRoles 一致：
  // 逗号分隔，同一天只开一行，不为每个兼任岗位单独建行（唯一约束是 [userId, effectiveFrom]）。
  secondaryPositions String?
  groupId            String
  effectiveFrom      String
  effectiveTo        String?
  reason             String?
  createdById        String?
  createdAt          DateTime  @default(now())
  user               User      @relation("UserPositionAssignee", fields: [userId], references: [id], onDelete: Cascade)
  group              TeamGroup @relation(fields: [groupId], references: [id])
  createdBy          User?     @relation("UserPositionCreatedBy", fields: [createdById], references: [id])

  @@unique([userId, effectiveFrom])
  @@index([groupId, effectiveFrom, effectiveTo])
  @@index([userId, effectiveTo])
}

// 资源部账号按渠道目录 ID 授权；同一目录渠道在各小组的副本共用同一个 channelId。
model ResourceChannelAccess {
  userId    String
  channelId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
}

model TeamGroup {
  id                          String                @id
  name                        String
  groupType                   GroupType             @default(HACKER)
  active                      Boolean               @default(true)
  departmentId                String                @default("default-department")
  department                  Department            @relation(fields: [departmentId], references: [id])
  countryCode                 String?
  timezone                    String?
  workStartMinutes            Int?
  workEndMinutes              Int?
  members                     User[]
  membershipHistory           UserGroupMembership[]
  positionHistory             UserPosition[]
  channels                    Channel[]
  batches                     SourceBatch[]
  channelReviewEntries        ChannelReviewEntry[]
  devices                     Device[]
  deviceAccounts              DeviceAccount[]
  attendanceRecords           AttendanceRecord[]
  receptionJoinPassRate       Int                   @default(10)
  receptionJoinGoodRate       Int                   @default(15)
  receptionJoinExcellentRate  Int                   @default(20)
  operatorExpertPassRate      Int                   @default(60)
  operatorExpertGoodRate      Int                   @default(70)
  operatorExpertExcellentRate Int                   @default(80)
  expertOrderPassRate         Int                   @default(10)
  expertOrderGoodRate         Int                   @default(15)
  expertOrderExcellentRate    Int                   @default(20)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  dailyStatEntries            DailyStatEntry[]
  currentCustomers            LeadCustomer[]        @relation("CurrentCustomerGroup")

  @@unique([departmentId, name])
}

// 一键更换组长计划。未来日期先保存为 PENDING，到小组当地生效日再原子执行；
// 所有人员、任职和客户交接仍写回原有权威表，本表只保存计划及执行结果。
model GroupLeadChangePlan {
  id                       String  @id @default(cuid())
  groupId                  String
  formerLeadId             String
  newLeadId                String
  effectiveOn              String
  formerDisposition        String
  formerTargetGroupId      String?
  formerReceptionHandoffId String?
  formerOperatorHandoffId  String?
  formerExpertHandoffId    String?
  newReceptionHandoffId    String?
  newOperatorHandoffId     String?
  newExpertHandoffId       String?
  reason                   String
  status                   String  @default("PENDING")
  createdById              String
  appliedAt                String?
  cancelledAt              String?
  failureReason            String?
  createdAt                String  @default("")
  updatedAt                String  @default("")

  @@index([groupId, status])
  @@index([status, effectiveOn])
}

model Channel {
  id                     String
  name                   String
  normalizedName         String
  active                 Boolean              @default(true)
  groupId                String
  group                  TeamGroup            @relation(fields: [groupId], references: [id])
  createdById            String?
  createdBy              User?                @relation("ChannelCreatedBy", fields: [createdById], references: [id])
  // 以下三列仅保留旧版本回滚兼容，新版业务不使用。
  fanCostMode            FanCostMode          @default(FREE)
  effectiveFanPriceCents Int?
  rebateRateBps          Int?
  channelType            ChannelType          @default(SMS)
  batches                SourceBatch[]
  channelReviewEntries   ChannelReviewEntry[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  dailyStatEntries       DailyStatEntry[]

  @@id([id, groupId])
  @@unique([groupId, normalizedName])
}

// 组长与资源部的按天对账（需求文档4.5）：组长在"渠道数据核对"页面把某个渠道当天的数据发给
// 对应渠道的资源部账号审核；资源部确认无误（CONFIRMED，终态，不能撤销）或标记异议
// （DISPUTED，必须写 note），组长自己的页面据此看到回执。模式抄自 InvalidFanReport 的
// reporter/reviewedBy 分工，但这里没有 InvalidFanReportAudit 那种前后快照表——对账双方
// 只关心"这一天这个渠道的数据是否一致"这一个状态，不像废号审核要追踪具体数量改动。
enum ChannelReviewStatus {
  SENT
  CONFIRMED
  DISPUTED
}

model ChannelReviewEntry {
  id           String              @id @default(cuid())
  groupId      String
  channelId    String
  // 被核对的那一天（组长自己小组的当地日历日），不是提交时间。
  reviewDate   String
  status       ChannelReviewStatus @default(SENT)
  // 只在 DISPUTED 时必填；重新发送（SENT）会清空上一轮的异议说明。
  note         String?
  sentById     String
  sentAt       DateTime            @default(now())
  reviewedById String?
  reviewedAt   DateTime?
  group        TeamGroup           @relation(fields: [groupId], references: [id])
  channel      Channel             @relation(fields: [channelId, groupId], references: [id, groupId])
  sentBy       User                @relation("ChannelReviewSentBy", fields: [sentById], references: [id])
  reviewedBy   User?               @relation("ChannelReviewReviewedBy", fields: [reviewedById], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  // 一个小组的一个渠道一天只有一条对账记录；重新发送是 upsert 回同一行，不是新建。
  @@unique([groupId, channelId, reviewDate])
  @@index([channelId, status])
  @@index([groupId, reviewDate])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  summary    String
  actor      User     @relation(fields: [actorId], references: [id])
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model RiskDecision {
  id              String            @id @default(cuid())
  memberId        String
  actorId         String
  level           RiskDecisionLevel
  evidenceThrough String
  reason          String
  member          User              @relation("RiskDecisionMember", fields: [memberId], references: [id])
  actor           User              @relation("RiskDecisionActor", fields: [actorId], references: [id])
  createdAt       DateTime          @default(now())

  @@index([memberId, createdAt])
}

model SystemSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model SourceBatch {
  id                             String                 @id @default(cuid())
  groupId                        String
  channelId                      String
  sourceDate                     String
  // 以下六列仅保留旧版本回滚兼容，新版业务不使用。
  fanCostModeSnapshot            FanCostMode            @default(FREE)
  effectiveFanPriceCentsSnapshot Int?
  rebateRateBpsSnapshot          Int?
  advertisingSpendCents          Int?
  advertisingFanCount            Int?
  advertisingServiceFeeRateBps   Int?
  channelTypeSnapshot            ChannelType            @default(SMS)
  // 老客户补录使用独立批次：保留业绩和资金，但不参与新粉和有效粉。
  isHistoricalRecord             Boolean                @default(false)
  group                          TeamGroup              @relation(fields: [groupId], references: [id])
  channel                        Channel                @relation(fields: [channelId, groupId], references: [id, groupId])
  events                         MetricEvent[]
  customerFinanceEvents          CustomerFinanceEvent[]
  customerOrders                 CustomerOrder[]
  leads                          LeadCustomer[]
  exceptions                     LeadException[]
  invalidFanReports              InvalidFanReport[]
  createdAt                      DateTime               @default(now())
  updatedAt                      DateTime               @updatedAt

  @@unique([groupId, channelId, sourceDate])
  @@index([groupId, sourceDate])
}

model MetricEvent {
  id                 String         @id @default(cuid())
  batchId            String
  enteredById        String
  occurredOn         String
  kind               MetricKind
  quantity           Int?
  amountCents        Int?
  depositMethod      DepositMethod?
  derivedFromLedger  Boolean        @default(false)
  parentEventId      String?
  customerOrderId    String?
  continuationNumber Int?
  voidedAt           DateTime?
  voidReason         String?
  voidedById         String?
  // 写入时从 enteredById 当时持有的 UserPosition 冻结进来，不查 User 当前状态；
  // 只能通过 recordMetricEvent 写入函数生成，禁止直接 metricEvent.create（阶段2，需求文档1.6）。
  actingPosition     Position?
  batch              SourceBatch    @relation(fields: [batchId], references: [id])
  enteredBy          User           @relation(fields: [enteredById], references: [id])
  parentEvent        MetricEvent?   @relation("GroupLeaveOrigin", fields: [parentEventId], references: [id], onDelete: SetNull)
  childEvents        MetricEvent[]  @relation("GroupLeaveOrigin")
  customerOrder      CustomerOrder? @relation(fields: [customerOrderId], references: [id], onDelete: SetNull)
  voidedBy           User?          @relation("MetricEventVoidedBy", fields: [voidedById], references: [id])
  createdAt          DateTime       @default(now())

  @@unique([customerOrderId, continuationNumber])
  @@index([parentEventId])
  @@index([customerOrderId])
  @@index([batchId, occurredOn])
  @@index([enteredById, occurredOn])
  @@index([kind, occurredOn])
}

// 独立的每日统计账。identityKey 把“人+岗位+日期+渠道+来源线”锁成唯一一行，
// 不依赖客户号码或客户状态，报表只读取 approvedRevision。
model DailyStatEntry {
  id                    String              @id @default(cuid())
  identityKey           String              @unique
  ownerId               String
  groupId               String
  channelId             String
  businessDate          String
  timezone              String
  position              Position
  sourceReceptionId     String?
  sourceGroupOperatorId String?
  status                DailyStatStatus     @default(DRAFT)
  currentRevisionId     String?             @unique
  approvedRevisionId    String?             @unique
  submittedAt           DateTime?
  reviewedById          String?
  reviewedAt            DateTime?
  reviewReason          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  owner                 User                @relation("DailyStatOwner", fields: [ownerId], references: [id])
  group                 TeamGroup           @relation(fields: [groupId], references: [id])
  channel               Channel             @relation(fields: [channelId, groupId], references: [id, groupId])
  sourceReception       User?               @relation("DailyStatReceptionSource", fields: [sourceReceptionId], references: [id], onDelete: SetNull)
  sourceGroupOperator   User?               @relation("DailyStatOperatorSource", fields: [sourceGroupOperatorId], references: [id], onDelete: SetNull)
  reviewedBy            User?               @relation("DailyStatReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  revisions             DailyStatRevision[] @relation("DailyStatRevisionEntry")
  currentRevision       DailyStatRevision?  @relation("DailyStatCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  approvedRevision      DailyStatRevision?  @relation("DailyStatApprovedRevision", fields: [approvedRevisionId], references: [id], onDelete: SetNull)

  @@index([ownerId, businessDate])
  @@index([groupId, businessDate, position])
  @@index([channelId, businessDate])
  @@index([status, groupId, businessDate])
  @@index([sourceReceptionId, businessDate])
  @@index([sourceGroupOperatorId, businessDate])
}

// 每次保存都新增版本，不覆盖旧值。审核通过只切换 DailyStatEntry.approvedRevisionId。
model DailyStatRevision {
  id                        String          @id @default(cuid())
  entryId                   String
  version                   Int
  createdById               String
  changeReason              String?
  dispatchCount             Int             @default(0)
  duplicateCount            Int             @default(0)
  lowAmountCount            Int             @default(0)
  noWsCount                 Int             @default(0)
  manualInvalidCount        Int             @default(0)
  lawyerRealCaseCount       Int             @default(0)
  lawyerAddedCount          Int             @default(0)
  lawyerExpertAddedCount    Int             @default(0)
  customerServicePushCount  Int             @default(0)
  effectiveCount            Int             @default(0)
  replyCount                Int             @default(0)
  joinCount                 Int             @default(0)
  operatorReceivedCount     Int             @default(0)
  normalLeaveCount          Int             @default(0)
  abnormalLeaveCount        Int             @default(0)
  currentInGroupCount       Int             @default(0)
  expertIntroCount          Int             @default(0)
  expertReceivedCount       Int             @default(0)
  expertContactedCount      Int             @default(0)
  registrationCount         Int             @default(0)
  orderCount                Int             @default(0)
  cryptoInitialDepositCents Int             @default(0)
  bankInitialDepositCents   Int             @default(0)
  cryptoRechargeCents       Int             @default(0)
  bankRechargeCents         Int             @default(0)
  withdrawalCents           Int             @default(0)
  createdAt                 DateTime        @default(now())
  entry                     DailyStatEntry  @relation("DailyStatRevisionEntry", fields: [entryId], references: [id], onDelete: Cascade)
  createdBy                 User            @relation("DailyStatRevisionCreator", fields: [createdById], references: [id])
  currentFor                DailyStatEntry? @relation("DailyStatCurrentRevision")
  approvedFor               DailyStatEntry? @relation("DailyStatApprovedRevision")

  @@unique([entryId, version])
  @@index([createdById, createdAt])
}

model CustomerOrder {
  id                   String                 @id @default(cuid())
  phone                String                 @unique
  batchId              String
  enteredById          String
  openedOn             String
  initialDepositCents  Int
  initialDepositMethod DepositMethod?
  // 仅保留线上结构兼容；新版不提供“历史已开单”业务入口。
  isHistoricalBaseline Boolean                @default(false)
  leadId               String?                @unique
  voidedAt             DateTime?
  voidReason           String?
  voidedById           String?
  batch                SourceBatch            @relation(fields: [batchId], references: [id])
  enteredBy            User                   @relation(fields: [enteredById], references: [id])
  lead                 LeadCustomer?          @relation(fields: [leadId], references: [id])
  metricEvents         MetricEvent[]
  events               CustomerFinanceEvent[]
  voidedBy             User?                  @relation("OrderVoidedBy", fields: [voidedById], references: [id])
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([enteredById, openedOn])
  @@index([batchId])
}

// 客户资金跟踪的独立明细账。它只服务客户进度，不参与任何统计报表；
// 每日/区间统计的唯一来源仍是 DailyStatEntry 的正式版本。
model CustomerFinanceEvent {
  id                 String         @id @default(cuid())
  batchId            String
  customerOrderId    String
  enteredById        String
  occurredOn         String
  kind               MetricKind
  amountCents        Int
  depositMethod      DepositMethod?
  continuationNumber Int?
  voidedAt           DateTime?
  voidReason         String?
  voidedById         String?
  batch              SourceBatch    @relation(fields: [batchId], references: [id])
  customerOrder      CustomerOrder  @relation(fields: [customerOrderId], references: [id], onDelete: Cascade)
  enteredBy          User           @relation("CustomerFinanceEnteredBy", fields: [enteredById], references: [id])
  voidedBy           User?          @relation("CustomerFinanceVoidedBy", fields: [voidedById], references: [id])
  createdAt          DateTime       @default(now())

  @@unique([customerOrderId, continuationNumber])
  @@index([customerOrderId, occurredOn])
  @@index([enteredById, occurredOn])
  @@index([batchId, occurredOn])
}

model LeadCustomer {
  id                            String                  @id @default(cuid())
  phone                         String                  @unique
  batchId                       String
  // 当前工作小组；为空表示仍在来源批次小组。跨组调动只改这里，batchId 永久保留历史来源。
  currentGroupId                String?
  ownerId                       String
  // 录入人负责客户流程；粉的归属用于代理线和后续业绩归属，二者可以不同。
  attributionOwnerId            String?
  deviceId                      String?
  // 客户在三个交接阶段所使用的联系账号。号码快照保留历史，账号后来删除或改号也不影响复核。
  groupDeviceAccountId          String?
  groupDeviceAccountNumber      String?
  expertDeviceAccountId         String?
  expertDeviceAccountNumber     String?
  invalid                       Boolean                 @default(false)
  invalidReason                 String?
  receptionCategory             ReceptionCategory       @default(VALID)
  replyStatus                   LeadReplyStatus         @default(NOT_REPLIED)
  repliedOn                     String?
  followUpCount                 Int                     @default(0)
  lastFollowedUpOn              String?
  customerName                  String?
  customerEmail                 String?
  lossAmountCents               Int?
  customerPlatform              String?
  // 两个阶段的固定流水号：进群时取得 G 编号，首次推专家时再取得 E 编号。
  // GroupId 快照用于保证客户后来调组时原编号仍可追溯且不会与原组重复。
  groupQueueNumber              Int?
  groupQueueGroupId             String?
  expertQueueNumber             Int?
  expertQueueGroupId            String?
  groupStatus                   LeadGroupStatus         @default(NOT_JOINED)
  joinedOn                      String?
  leftOn                        String?
  leftWithOrder                 Boolean?
  leftNote                      String?
  leftAutomatically             Boolean                 @default(false)
  expertIntroducedOn            String?
  expertContactedOn             String?
  expertContactNote             String?
  expertNotes                   String?
  expertWorkflowStage           ExpertWorkflowStage?
  expertStageChangedAt          DateTime?
  expertTrackingStartedAt       DateTime?
  expertStalledOn               String?
  expertStalledReason           String?
  expertStalledNote             String?
  noInitialDepositOn            String?
  noInitialDepositReason        String?
  noInitialDepositNote          String?
  registeredOn                  String?
  nextPlan                      String?
  nextFollowUpOn                String?
  notes                         String?
  receptionChatStatus           ReceptionChatStatus     @default(NORMAL_CHAT)
  receptionStatusChangedAt      DateTime?
  receptionArchivedAt           DateTime?
  receptionArchiveReason        String?
  receptionArchiveVisitCount    Int?
  // 历史补录客户不算作今天新接的粉；真实来源名称单独保存用于复核。
  isHistoricalRecord            Boolean                 @default(false)
  historicalSourceName          String?
  historicalBaselineStage       String?
  historicalReplyCounted        Boolean                 @default(false)
  historicalJoinCounted         Boolean                 @default(false)
  historicalLeaveCounted        Boolean                 @default(false)
  historicalExpertIntroCounted  Boolean                 @default(false)
  historicalRegistrationCounted Boolean                 @default(false)
  // 历史补录必须组长审核才生效，未审核前不进任何报表（需求文档7.3，模式抄自 InvalidFanReport）。
  historicalReviewStatus        HistoricalReviewStatus?
  historicalReviewedById        String?
  historicalReviewedAt          DateTime?
  batch                         SourceBatch             @relation(fields: [batchId], references: [id])
  currentGroup                  TeamGroup?              @relation("CurrentCustomerGroup", fields: [currentGroupId], references: [id])
  owner                         User                    @relation(fields: [ownerId], references: [id])
  attributionOwner              User?                   @relation("FanAttributionOwner", fields: [attributionOwnerId], references: [id])
  device                        Device?                 @relation(fields: [deviceId], references: [id])
  customerOrder                 CustomerOrder?
  expertOwnerId                 String?
  expertOwner                   User?                   @relation("ExpertOwner", fields: [expertOwnerId], references: [id])
  groupOperatorOwnerId          String?
  groupOperatorOwner            User?                   @relation("GroupOperatorOwner", fields: [groupOperatorOwnerId], references: [id])
  historicalReviewedBy          User?                   @relation("HistoricalReviewedBy", fields: [historicalReviewedById], references: [id])
  activities                    LeadActivity[]
  exceptions                    LeadException[]
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt

  @@index([ownerId, updatedAt])
  @@index([ownerId, receptionChatStatus, updatedAt])
  @@index([ownerId, receptionArchivedAt])
  @@index([attributionOwnerId, updatedAt])
  @@index([ownerId, receptionCategory, updatedAt])
  @@index([batchId, groupStatus, updatedAt])
  @@index([currentGroupId, updatedAt])
  @@index([batchId, invalid, groupStatus, expertIntroducedOn])
  @@index([batchId, invalid, expertOwnerId, registeredOn])
  @@index([deviceId])
  @@index([groupDeviceAccountId])
  @@index([expertDeviceAccountId])
  @@index([expertOwnerId, updatedAt])
  @@index([expertOwnerId, expertWorkflowStage, expertTrackingStartedAt])
  @@index([expertOwnerId, expertStalledOn, updatedAt])
  @@index([expertOwnerId, noInitialDepositOn, updatedAt])
  @@index([groupOperatorOwnerId, updatedAt])
  @@index([isHistoricalRecord, historicalReviewStatus])
  @@unique([groupQueueGroupId, groupQueueNumber])
  @@unique([expertQueueGroupId, expertQueueNumber])
}

// 每个小组分别维护在群、推专家两个原子计数器。不能用“当前行数 + 1”，
// 否则删除记录或两个人同时操作时会产生重复编号。
model CustomerStageSequence {
  groupId          String   @id
  lastGroupNumber  Int      @default(0)
  lastExpertNumber Int      @default(0)
  updatedAt        DateTime @updatedAt
}

model GroupOperatorReception {
  groupOperatorId String
  receptionistId  String   @unique
  groupOperator   User     @relation("GroupOperatorAssignments", fields: [groupOperatorId], references: [id], onDelete: Cascade)
  receptionist    User     @relation("ReceptionistAssignments", fields: [receptionistId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@id([groupOperatorId, receptionistId])
}

// 当前配对仍由 GroupOperatorReception 提供快速、兼容的读取；本表只追加历史版本，
// 用来回答“某天谁和谁配对”，换配对不会覆盖旧关系。
model GroupOperatorReceptionHistory {
  id              String    @id @default(cuid())
  groupOperatorId String
  receptionistId  String
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  reason          String?
  createdById     String?
  groupOperator   User      @relation("GroupOperatorPairingHistory", fields: [groupOperatorId], references: [id], onDelete: Cascade)
  receptionist    User      @relation("ReceptionistPairingHistory", fields: [receptionistId], references: [id], onDelete: Cascade)
  createdBy       User?     @relation("PairingHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())

  @@index([receptionistId, effectiveFrom, effectiveTo])
  @@index([groupOperatorId, effectiveFrom, effectiveTo])
  @@index([createdById])
}

model Device {
  id        String         @id @default(cuid())
  code      String
  groupId   String
  memberId  String?
  active    Boolean        @default(true)
  group     TeamGroup      @relation(fields: [groupId], references: [id])
  member    User?          @relation("DeviceAssignedMember", fields: [memberId], references: [id])
  leads     LeadCustomer[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([groupId, code])
  @@index([memberId, active])
}

model DeviceAccount {
  id            String            @id @default(cuid())
  groupId       String
  ownerId       String
  accountType   DeviceAccountType
  provider      String
  accountNumber String
  renewalDate   String?
  purpose       String?
  situation     String?
  phoneCode     String?
  followUp      String?
  group         TeamGroup         @relation(fields: [groupId], references: [id])
  owner         User              @relation(fields: [ownerId], references: [id])
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([groupId, accountNumber])
  @@index([ownerId, updatedAt])
  @@index([groupId, renewalDate])
}

model LeadActivity {
  id         String           @id @default(cuid())
  leadId     String
  actorId    String
  kind       LeadActivityKind
  occurredOn String
  note       String?
  lead       LeadCustomer     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actor      User             @relation(fields: [actorId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([leadId, createdAt])
  @@index([actorId, occurredOn])
}

model LeadException {
  id         String            @id @default(cuid())
  batchId    String?
  leadId     String?
  actorId    String
  ownerId    String?
  phone      String
  kind       LeadExceptionKind
  reason     String?
  occurredOn String
  batch      SourceBatch?      @relation(fields: [batchId], references: [id], onDelete: SetNull)
  lead       LeadCustomer?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  actor      User              @relation("ExceptionActor", fields: [actorId], references: [id])
  owner      User?             @relation("ExceptionOwner", fields: [ownerId], references: [id])
  createdAt  DateTime          @default(now())

  @@index([actorId, occurredOn])
  @@index([ownerId, occurredOn])
  @@index([batchId])
}

model InvalidFanReport {
  id                     String                  @id @default(cuid())
  batchId                String
  reporterId             String
  status                 InvalidFanReportStatus  @default(PENDING)
  noWsCount              Int                     @default(0)
  lowAmountCount         Int                     @default(0)
  collisionCount         Int                     @default(0)
  approvedNoWsCount      Int?
  approvedLowAmountCount Int?
  approvedCollisionCount Int?
  reviewReason           String?
  reviewedAt             DateTime?
  reviewedById           String?
  isLeaderSupplement     Boolean                 @default(false)
  batch                  SourceBatch             @relation(fields: [batchId], references: [id], onDelete: Cascade)
  reporter               User                    @relation("InvalidFanReportReporter", fields: [reporterId], references: [id])
  reviewedBy             User?                   @relation("InvalidFanReportReviewer", fields: [reviewedById], references: [id])
  audits                 InvalidFanReportAudit[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@unique([batchId, reporterId])
  @@index([batchId, status])
  @@index([reporterId, status, updatedAt])
}

model InvalidFanReportAudit {
  id                   String                 @id @default(cuid())
  reportId             String
  actorId              String
  action               InvalidFanReportAction
  beforeNoWsCount      Int?
  beforeLowAmountCount Int?
  beforeCollisionCount Int?
  afterNoWsCount       Int?
  afterLowAmountCount  Int?
  afterCollisionCount  Int?
  reason               String?
  report               InvalidFanReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actor                User                   @relation("InvalidFanReportAuditActor", fields: [actorId], references: [id])
  createdAt            DateTime               @default(now())

  @@index([reportId, createdAt])
  @@index([actorId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model DailyEntryConfirmation {
  id           String   @id @default(cuid())
  userId       String
  businessDate String
  confirmedAt  DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, businessDate])
  @@index([businessDate])
}

model AttendanceRecord {
  id                    String                    @id @default(cuid())
  userId                String
  groupId               String
  businessDate          String
  timezone              String
  scheduledStartMinutes Int
  scheduledEndMinutes   Int
  clockInAt             DateTime?
  clockOutAt            DateTime?
  clockInStatus         AttendanceClockStatus?
  clockOutStatus        AttendanceClockStatus?
  leaveType             AttendanceLeaveType?
  leaveDuration         AttendanceLeaveDuration?
  leaveReason           String?
  leaveAt               DateTime?
  isHistoricalRecord    Boolean                   @default(false)
  historicalMark        AttendanceHistoricalMark?
  historicalSourceName  String?
  user                  User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  group                 TeamGroup                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@unique([userId, businessDate])
  @@index([groupId, businessDate])
  @@index([businessDate])
}

model Notification {
  id                 String                  @id @default(cuid())
  title              String
  content            String
  type               NotificationType        @default(GENERAL)
  requiresAck        Boolean                 @default(false)
  targetType         NotificationTargetType
  senderId           String
  targetDepartmentId String?
  targetGroupId      String?
  targetRole         Role?
  expiresAt          DateTime?
  sender             User                    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipients         NotificationRecipient[]
  createdAt          DateTime                @default(now())

  @@index([createdAt])
  @@index([senderId])
  @@index([targetDepartmentId])
  @@index([targetGroupId])
}

model NotificationRecipient {
  id             String       @id @default(cuid())
  notificationId String
  userId         String
  readAt         DateTime?
  acknowledgedAt DateTime?
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId, readAt])
}

// 老客户导入共享表与新客户流程完全独立：所有原始字段由组内成员自由填写，
// 退群日期、群内天数和净业绩由系统根据这些原始字段计算。
model LegacyCustomerRow {
  id                    String   @id @default(cuid())
  groupId               String
  createdById           String
  updatedById           String
  joinedOn              String?
  phone                 String   @default("")
  attributionMemberName String   @default("")
  sourceChannelName     String   @default("")
  groupOperatorName     String   @default("")
  deviceCode            String   @default("")
  groupSituation        String   @default("")
  leaveType             String   @default("")
  leftOn                String?
  expertName            String   @default("")
  expertSituation       String   @default("")
  registeredOn          String?
  initialDepositCents   Int      @default(0)
  rechargeCents         Int      @default(0)
  withdrawalCents       Int      @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([groupId, updatedAt])
  @@index([groupId, phone])
}
